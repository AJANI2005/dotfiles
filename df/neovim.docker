FROM archlinux:latest

RUN pacman -Syu --noconfirm \
    neovim \
    fzf \
    ripgrep \
    nodejs \
    npm \
    curl \
    git \
    wget \
    wl-clipboard \
    ca-certificates \
    go \
    unzip \
    rust \
    && pacman -Scc --noconfirm

ENV EDITOR=nvim
ENV VISUAL=nvim

COPY nvim /root/.config/nvim

WORKDIR /workspace

ENTRYPOINT ["nvim"]
