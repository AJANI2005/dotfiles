# Global styling and positioning
font=JetBrainsMono Nerd Font 10
background-color=#181818f0
text-color=#d0d0d0
width=320
height=110
margin=10
padding=12
border-size=1
border-color=#333333
border-radius=8
icons=1
max-icon-size=32
markup=1
actions=1
format=<b>%s</b>\n%b
sort=-time
layer=overlay

# Default urgency settings
[urgency=low]
background-color=#121212f0
text-color=#888888
border-color=#222222
default-timeout=2000

[urgency=normal]
background-color=#181818f0
text-color=#d0d0d0
border-color=#333333
default-timeout=4000

[urgency=high]
background-color=#181818f0
text-color=#ffffff
border-color=#e6e6e6
default-timeout=4000
